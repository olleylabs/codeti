{
  "name": "codeti-baseball-aggregator",
  "version": "1.0.0",
  "private": true,
  "description": "Aggregates FAQ questions from Baseball Reference player pages whose name contains exactly three occurrences of the letter 'a'.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "start": "tsx src/index.ts",
    "refresh": "tsx src/index.ts --refresh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "p-limit": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.0"
  }
}
